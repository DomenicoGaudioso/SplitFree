{
  "expo": {
    "name": "SplitFree",
    "slug": "splitfree",
    "scheme": "splitfree",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domenicogaudioso.splitfree"
    },
    "android": {
      "package": "com.domenicogaudioso.splitfree",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "SplitFree usa le tue foto per allegare ricevute alle spese.",
          "cameraPermission": "SplitFree usa la fotocamera per fotografare ricevute da allegare alle spese."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
